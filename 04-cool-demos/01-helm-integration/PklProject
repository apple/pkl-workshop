amends "pkl:Project"

dependencies {
  ["helm"] {
    uri = "package://pkg.pkl-lang.org/pkl-readers/helm@0.1.2"
  }
  ["k8s"] {
    uri = "package://pkg.pkl-lang.org/pkl-k8s/k8s@1.4.1"
